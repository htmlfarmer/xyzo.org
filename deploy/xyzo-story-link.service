[Unit]
Description=Xyzo story linking + PageRank — refresh news_story_links + pagerank_score
Documentation=https://github.com/htmlfarmer/xyzo.org
After=network-online.target postgresql.service xyzo-api.service
Wants=network-online.target
# We need the API up because the trigger hits POST /api/links/detect.
# The .timer that drives this unit is xyzo-story-link.timer.

[Service]
Type=oneshot
WorkingDirectory=/var/www/vhosts/xyzo.org
Environment=XYZO_API_BASE=http://127.0.0.1:3008
Environment=XYZO_DB_URL=postgres://xyzo_app:CHANGE_ME@localhost:5432/xyzo
# The DSN above is a PLACEHOLDER — the repo carries no credentials.
# The real value lives outside the repo; EnvironmentFile= overrides Environment=.
EnvironmentFile=-/etc/xyzo/xyzo.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/var/www/vhosts/xyzo.org/scripts/trigger-story-link.sh
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xyzo-story-link
Nice=10

[Install]
WantedBy=multi-user.target
