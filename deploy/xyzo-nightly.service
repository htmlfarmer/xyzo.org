[Unit]
Description=Xyzo Nightly Automation (3 AM full cycle + discovery)
After=network.target postgresql.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/vhosts/xyzo.org
ExecStart=/var/www/vhosts/xyzo.org/scripts/nightly-automation.sh
# DB credentials come from the operator-managed env file — no in-unit default.
EnvironmentFile=/etc/xyzo/xyzo.env
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal
# The nightly does a full AI extraction cycle (2,000 articles) plus source
# discovery, coverage-gap analysis and search-log analysis. On a loaded box
# the extraction cycle alone takes ~1h45m, so the old 3600s (1h) limit
# killed the job mid-run every night — it always failed with a timeout and
# never reached the cleanup/verification steps.
TimeoutStartSec=14400

[Install]
WantedBy=multi-user.target
