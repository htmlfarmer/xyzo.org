# Per-repo allowlist for the secret/leak gate (secretz --code + secretz --gate).
# One ERE per line; matching LINES and PATHS are excluded from the scan.
# `#` comments and blank lines are ignored.
#
# EVERY entry below is an idiom that CANNOT contain a literal credential —
# never a value that could be one. Keep it that way: an allowlist that grows
# a broad pattern is a hole in the scan, not a cleanup.

# ── Credentials that live in the environment, not in this file ──────────────
# (reading an env var is the SAFE pattern; the credential it yields is not here)
YOUTUBE_CLIENT_SECRET
YOUTUBE_REFRESH_TOKEN
oauth2\.googleapis\.com/token
accounts\.google\.com/o/oauth2/auth
flow\.credentials\.refresh_token
os\.environ\.get\(
c\.req\.header\(

# ── A path this repo deliberately ships ─────────────────────────────────────
# api/.env.test is loaded by api/bunfig.toml (envfile = ".env.test") and by
# scripts/ci.sh, so it has to be tracked. It carries no credential: NODE_ENV
# and a CHANGE_ME DSN for the isolated xyzo_test database.
api/\.env\.test

# ── Shell/DSN interpolation: `$VAR` is a reference, never a literal ─────────
# Matches the userinfo of `postgresql://$DB_USER:$DB_PASS@host` and
# `postgresql://${USER:-asher}@host` — no password exists in the line.
://\$\{?[A-Za-z_]

# ── SQL self-reference: a row's own incoming column, not a value ────────────
= EXCLUDED\.

# ── Identifiers and function calls: the "value" after = is code ─────────────
AutoTokenizer\.
torch\.
gen_random_uuid\(
uuid4\(\)\.hex
newDashboardToken\(
header\.slice\(
\.toLowerCase\(
conn2\.execute\(
AUTH_RX\.test\(
_list_playlist_items\(
_check_authority_signals\(
inlineTokens\(

# ── Local metric / field names (assignment targets, not secrets) ────────────
authority_score =
authority_signals =
type_token_ratio =
stale_token =
"tokens_in":
"tokens_out":
"tokens":
author_name:
authorized_data_categories:

# ── Prose that merely mentions a token ──────────────────────────────────────
Earthdata token is configured
level token is "10_m_above_ground"
a stale token is invisible

# ── Model-config / metric field names (docs and code, never a secret) ───────
max_tokens":
placeTokens =

# TypeScript/JS: `NAME = process.env.SOMETHING` — the SAME idiom as
# `os.environ.get(` above, and the reason that one is allowed. The line
# carries an INDIRECTION; the credential lives in the environment and is
# not in this repository. Anchored on the assignment so a literal
# sitting next to an env reference (`KEY = "sk-…" + process.env.X`) is
# still scanned — only "the value IS the env read" is exempt.
[:=][[:space:]]*process\.env\.

# ── Safe-by-construction idioms: the value is a reference, not a literal ────
# sudoers: the PASSWD keyword of the NOPASSWD directive, not a password.
NOPASSWD:
# Python env-spreading — reads the environment, carries no literal.
\{\*\*os\.environ
