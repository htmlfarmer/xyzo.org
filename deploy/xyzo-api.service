[Unit]
Description=Xyzo API (Bun + Hono)
Documentation=file:/var/www/vhosts/xyzo.org/README.md
After=network-online.target postgresql.service
Wants=network-online.target
# If Caddy comes up first and the API isn't there, it sees 502s until
# the API is healthy. We don't strictly require Caddy; Caddy will retry.

[Service]
Type=simple
User=asher
Group=asher
WorkingDirectory=/var/www/vhosts/xyzo.org/api
EnvironmentFile=/var/www/vhosts/xyzo.org/api/.env
# Explicit port so a future staging unit can override cleanly via its own
# Environment= line (EnvironmentFile wins, but we keep both for clarity).
Environment=XYZO_PORT=3008
Environment=XYZO_VERSION=0.1.0
# -w 1 because Bun's HTTP server is single-process by design.
# --access-logfile - writes through to journald so logs are searchable.
ExecStart=/home/asher/.bun/bin/bun run src/server.ts
# Validate imports before starting — prevents crash-loops on missing exports
ExecStartPre=/var/www/vhosts/xyzo.org/scripts/validate-api.sh --quick
Restart=always
RestartSec=2
StartLimitIntervalSec=60
StartLimitBurst=10

# Resource limits. Bun will be killed and respawned by systemd if it
# starts to balloon — far better than a server-wide OOM.
MemoryMax=512M
MemoryHigh=384M
OOMPolicy=stop
OOMScoreAdjust=-200

# Hardening
NoNewPrivileges=true
ProtectSystem=full
# read-only (not `true`) so the unit can still read /home/asher/.bun where
# the bun binary lives. With ProtectHome=true the unit can't even launch
# its own ExecStart — status=203/EXEC. /tmp + /var are still writable via
# PrivateTmp + ReadWritePaths.
ProtectHome=read-only
PrivateTmp=true

# Bun needs to write to these for its internal caches / DNS.
ReadWritePaths=/var/www/vhosts/xyzo.org/api /tmp

StandardOutput=journal
StandardError=journal
SyslogIdentifier=xyzo-api

[Install]
WantedBy=multi-user.target