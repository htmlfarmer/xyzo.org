[Unit]
Description=XYZO search pre-index - compute the answers to the most-searched queries in the background
After=network.target postgresql.service xyzo-api.service

[Service]
Type=oneshot
# The database password lives in the root-only env file, not in the
# unit. A unit file is world-readable; a committed one is a published
# password.
EnvironmentFile=/etc/xyzo/xyzo.env
# --min-age 20: an entry younger than 20 minutes is LEFT ALONE, so each
# pass refreshes only what has aged. The list is ~1,400 queries, and
# this is what keeps the whole list current without the builder ever
# rebuilding all of it at once.
ExecStart=/usr/bin/python3 -m worker.search_preindex --build --limit 1400 --window 24h --window all --limits 1000 --min-age 20 --max 60 --sleep 2
User=asher
WorkingDirectory=/var/www/vhosts/xyzo.org

# The builder asks OUR OWN API for each answer — the search SQL lives in
# api/src/routes/pins.ts, and a second copy of it here would be a second
# implementation, and the second implementation is the one that drifts.
# It sends `X-Search-Fresh: 1`, which makes the API skip both its RAM
# cache and the pre-index, so the builder gets the LIVE answer and not
# the stored one it is about to replace.
#
# Only the default time window (24h) and the search path's limit (1,000)
# are built: they are what a reader actually asks for, and building
# every window for every query would multiply the work for answers
# nobody reads.

# The builder is a POLITE CITIZEN. Every entry is one heavy search query
# (the ranking runs over the whole corpus), so a thousand of them
# back-to-back is a thousand seconds of DATABASE TIME — and the reader's
# map load is the same database. Measured 2026-11-12: the builder running
# flat-out took the box to load average 23, and a friend's map took
# MINUTES to draw its markers while it did.
#
# So each pass builds a SLICE (60 entries) and pauses two seconds between
# entries. The whole list still refreshes — it just does not starve the
# site while it does.

# TWO WINDOWS ARE BUILT. "24h" is the site's DEFAULT time filter, and
# "all" is the one a reader picks when they want everything — and that
# is the expensive one (the ranking runs over the whole corpus). The
# pre-index is what makes it instant, so the builder answers BOTH.
