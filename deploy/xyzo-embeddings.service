[Unit]
Description=Xyzo article sentence embeddings — backfill nn_article_sentence_embeddings
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/var/www/vhosts/xyzo.org
Environment=XYZO_DB_URL=postgres://xyzo_app:CHANGE_ME@localhost:5432/xyzo
# The DSN above is a PLACEHOLDER — the repo carries no credentials.
# The real value lives outside the repo; EnvironmentFile= overrides Environment=.
EnvironmentFile=-/etc/xyzo/xyzo.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m worker.populate_embeddings --recent 7 --batch 256
StandardOutput=journal
StandardError=journal
SyslogIdentifier=xyzo-embeddings
Nice=15

[Install]
WantedBy=multi-user.target
