# REQUIRED — no default. Production deploys must set this in api/.env
# (loaded by deploy/xyzo-api.service via EnvironmentFile=).
XYZO_DB_URL=postgres://xyzo_app:CHANGE_ME@localhost:5432/xyzo

# REQUIRED for the /api/search and /api/explore routes, which spawn the
# Python worker. No default — a missing value fails fast.
#
# Canonical name is XYZO_DB_DSN. NEWSIUM_DB_DSN is accepted as a legacy
# alias (see api/src/routes/{search,explore}.ts and worker/db.py).
XYZO_DB_DSN=postgresql://xyzo_app:CHANGE_ME@localhost:5432/xyzo
NEWSIUM_DB_DSN=postgresql://xyzo_app:CHANGE_ME@localhost:5432/xyzo

# REQUIRED for the Wikipedia enrichment routes (api/src/wiki-db.ts).
XYZO_WIKI_DB_URL=postgres://xyzo_app:CHANGE_ME@localhost:5432/wikipedia

XYZO_PORT=3008
XYZO_VERSION=0.1.0

# ── AI routing for /api/ai/chat ─────────────────────────────────────
# Primary: hivv.org node service on localhost:3011. All user-facing
# chat traffic is logged in hivv's public activity feed. The connection
# is direct localhost (no Caddy hop) — public https://hivv.org/api/...
# is for external clients only.
# Fallback: separate host running llama.cpp + Gemma 3 27B. Hit only
# when the primary returns 502/503/504/timeout/connect-error.
# Defaults also live in api/src/routes/ai-chat.ts (silent fallback
# if these are unset — set them explicitly so the production routing
# is auditable from one file).
XYZO_AI_PRIMARY_URL=http://localhost:3011/v1/chat/completions
XYZO_AI_FALLBACK_URL=http://192.168.1.3:8888/v1/chat/completions
XYZO_AI_MODEL=gemma-4-E2B
XYZO_AI_TIMEOUT=25000
# Cap the answer length — the local 2B models otherwise write ~2000
# tokens (≈60s) and the browser sits on "Thinking…" the whole time.
XYZO_AI_MAX_TOKENS=512
# How many times to re-roll the gateway model lottery when a model
# answers with a safety refusal instead of an answer.
XYZO_AI_ATTEMPTS=2
XYZO_AI_TEMPERATURE=0.7
