api/.env
api/node_modules/
*.log
.DS_Store
__pycache__/
*.pyc
worker/.venv/
.venv/

# Agent runtime state (Claude Code / Minimax subagent bookkeeping)
.minimax/

# Test artifacts — regenerated on each UI test run
public_html/tests/screenshots/*.png

# Backups and logs — never commit
backups/
logs/

# runtime artifacts: model checkpoints, generated test traces/baselines
# (live on disk, referenced via auto-resolved paths; regenerable)
data/nn_models/
# A YEAR of the weather maps — a runtime artefact, regenerated by
# worker/weather_archive.py, and far too big for the repository.
data/weather_archive/
data/playwright_traces/
data/visual_baselines/
.tz-backfill-cutoff

# Rendered digest video — a build output, regenerated by worker/digest_render.py
data/digest_video/

# Runtime artefacts — regenerated, never committed
data/voices/
data/queue-soak-state.json
data/queue-soak-state.json.tmp
test-results/

# Downloaded source datasets (not in the repo — fetch them with the URL in
# the README section for that overlay)
maps/*.zip
maps/ne_rivers/
worker/data/*.nc
worker/data/phytoplankton/
worker/data/koppen/

# Runtime pause flag written by worker/load_guard.py
data/load_pause

# ── Generated overlay build artefacts ──────────────────────────────────────
# Every overlay under public_html/data/<name>/ is BUILT by a script (see the
# "Data Quality & Provenance" table in README.md). Its tile pyramid, probe
# grid, monthly planes and dissolved GeoJSON are all reproducible, and they
# are enormous — the tile pyramids alone are ~2.1 GB. They stay on disk for
# the running site; a fresh clone rebuilds them with the script named in that
# overlay's README section.
#
# The line is 4 MB: everything over it is ignored, every meta.json below it
# is committed (meta.json carries the licence + attribution that
# public_html/tests/data-licences.bun.test.js enforces, so it must ship).
# Use `git add -f` if a specific artefact genuinely has to be committed.
#
# NOTE: the Köppen pyramid under public_html/data/koppen/tiles/ is ALREADY
# tracked from before this rule existed, so it keeps tracking through these
# patterns — gitignore only ever applies to untracked files.
public_html/data/cropland/*/tiles/
public_html/data/soil/*/tiles/
public_html/data/etopo/tiles/
public_html/data/facebook/tiles/
public_html/data/soil/*/grid.bin
public_html/data/etopo/grid.bin
public_html/data/cropland/grid.bin
public_html/data/cropland/class.bin
public_html/data/lightning/grid_*.bin
public_html/data/phytoplankton/*.bin
public_html/data/basins/basins_major.geojson
public_html/data/basins/basins_detailed.geojson
public_html/data/rivers/fao/labels.geojson

# Generated by scripts/image_proxy_audit.py (it writes this scratch
# query into api/ and runs it with `bun run`); never removed after.
api/_imgs_audit_tmp.ts

# The 72 MB download of the FAO's classic rivers layer, cached by
# scripts/river_network_build.py. It is a build cache, it lives OUTSIDE
# the web root (it was briefly reachable at /data/rivers/fao/.cache/…
# and served 72 MB of a third party's data to anyone who asked), and a
# fresh clone re-downloads it with the script named in that overlay's
# README section.
data/river_network_cache/

# The FAO rivers TILE CACHE, written by the proxy
# (api/src/routes/faoRiversProxy.ts). It is the whole point of the proxy:
# the tile is fetched from the publisher ONCE and every reader after
# that is a local file. It is regenerated on demand, so it is never
# committed.
data/fao_rivers_tiles/
# The remote-tile mirror's disk cache (api/src/routes/tileMirror.ts).
# Outside the web root and never committed: it is a CACHE, revalidated
# against the origins on a TTL and pruned after 45 days.
data/tile_mirror/

# OUR OWN COPY of the 2026 FAO river network — 8,477,883 reaches, 654 MB,
# paged out of the publisher's WFS by scripts/river_network_fetch.py.
#
# It is the SOURCE for the rendered tile pyramid and it lives OUTSIDE the
# web root, because the upstream HydroSHEDS licence forbids distributing
# the data as a stand-alone product. **It is also 654 MB of somebody
# else's data, so it must never reach the repository** — a fresh clone
# re-fetches it with the script named in that overlay's README section
# (~95 minutes).
data/rivers_fao_2026/

# Downloaded SOURCE datasets for the builders above — same rule as
# maps/*.zip: fetch them with the URL in that overlay's README section.
# (maps/World_Koppen_Gerrit_Hendriksen.kml is tracked from before the
# Köppen source was replaced with Beck et al. 2018; see docs/DATA_LICENSES.md §4.)
maps/*.png
maps/*.csv
maps/*.geojson

# Downloaded geospatial datasets for the public map app (fetched by the
# download scripts — not source; ~217k files / 1.7GB on disk)
public_html/data/

# Scratch files from the audits. They are one-off probes against the live
# database, not part of the service.
api/_*_tmp.ts

# ── Published to GitHub: too large / not source (files stay on disk) ────────
# GitHub REJECTS any single file over 100 MB. These two are a downloaded
# GeoNames dump (744 MB unpacked, 194 MB as shipped) — a build input, not
# code. worker/import_city_names.py prints the download URL if it is missing.
data/alternateNamesV2.txt
data/alternateNamesV2.zip
# MaxMind GeoLite2 City — refreshed weekly by scripts/update-geolite.sh.
# It also carries MaxMind's own data licence, not ours (docs/DATA_LICENSES.md).
geoip/GeoLite2-City.mmdb
# Snapshots of the three frontend files taken before each deploy.
.deploy-backups/
